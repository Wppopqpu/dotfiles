{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"model": "anthropic/claude-fable-5.1",
	"small_model": "openai/gpt-4.1-nano",
	"plugin": ["opencode-workflow", "opencode-dynamic-context-pruning", "@mohak34/opencode-notifier@latest"],
	"instructions": ["~/opencode_skills/rust-skills/.opencode/instructions/rust-skills.md"],

	"provider": {
		"openai": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		},
		"anthropic": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		}
	}
}

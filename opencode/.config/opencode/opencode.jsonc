{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	// "model": "anthropic/claude-fable-5.1",
	"model": "openai/gpt-5.6-terra",
	"small_model": "openai/gpt-5.6-luna",
	"plugin": ["@tarquinen/opencode-dcp", "@mohak34/opencode-notifier"],

	"provider": {
		"openai": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		},
		"anthropic": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		}
	}
}

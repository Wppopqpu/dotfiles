{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	// "model": "anthropic/claude-fable-5.1",
	"model": "openai/gpt-5.6-terra",
	"small_model": "openai/gpt-4.1-nano",
	"plugin": ["opencode-workflow", "@tarquinen/opencode-dcp", "@mohak34/opencode-notifier"],
	"instructions": ["~/.config/opencode/skills/rust-skills/.opencode/instructions/rust-skills.md"],
	"skills": {
		"paths": ["~/.config/opencode/skills/rust-skills/skills"]
	},

	"provider": {
		"openai": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		},
		"anthropic": {
			"options": {
				"baseURL": "https://www.hejuapi.com/v1"
			}
		}
	}
}

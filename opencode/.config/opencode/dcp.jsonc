{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",

  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  "turnProtection": {
    "enabled": true,
    "turns": 3
  },

  "protectedFilePatterns": [
    "**/*.env",
    "**/*.env.*",
    "**/*secret*",
    "**/*credential*",
    "**/Cargo.lock",
    "**/package-lock.json"
  ],

  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    "summaryBuffer": true,
    "maxContextLimit": "70%",
    "minContextLimit": 250000,
    "nudgeFrequency": 3,
    "iterationNudgeThreshold": 15,
    "nudgeForce": "soft",
    "protectedTools": [],
    "protectTags": false,
    "protectUserMessages": false
  },

  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": []
    }
  },

  "commands": {
    "enabled": true,
    "protectedTools": []
  },

  "experimental": {
    "allowSubAgents": false,
    "customPrompts": false
  }
}
